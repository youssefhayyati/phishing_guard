# PhishGuard deploy settings (host-side).
# Copy this file to ".env" in this same folder, fill in the two URLs, then run:
#   docker compose up -d backend
# Docker Compose reads ".env" automatically.

# 1) The Git repo your campaign servers clone (the phishguard-campaign-runtime repo).
DEPLOY_REPO_URL=https://github.com/YOUR_USERNAME/phishguard-campaign-runtime.git
DEPLOY_BRANCH=master

# 2) The PUBLIC RabbitMQ URL your remote agents dial back on (from `ngrok tcp 5672`).
#    Replace HOST:PORT with the ngrok forwarding address (e.g. 6.tcp.ngrok.io:14321).
DEPLOY_AMQP_PUBLIC_URL=amqp://phishguard:phishguard_dev@HOST:PORT/

# (Optional) change the RabbitMQ password used locally + remotely.
RABBITMQ_PASS=phishguard_dev
