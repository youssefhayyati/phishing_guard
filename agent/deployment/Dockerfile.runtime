# Lean PhishGuard agent image for campaign deployment.
# Installs only what the running agent needs (RabbitMQ messaging + CDP polling),
# not the full Playwright/browser toolchain — keeps remote builds fast and small.
# Runs as a non-root user (STRATEGY.md section 7.2).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/phishguard-agent

COPY requirements-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-runtime.txt

COPY app ./app
COPY pyproject.toml ./

RUN useradd --create-home --uid 10001 agent \
    && chown -R agent:agent /opt/phishguard-agent
USER agent

ENTRYPOINT ["python", "-m", "app.main"]
