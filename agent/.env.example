# PhishGuard agent configuration (see app/config.py)
# Unique agent identity (section 13)
PHISHGUARD_AGENT_ID=00000000-0000-0000-0000-000000000000
PHISHGUARD_AGENT_VERSION=1.0.0

# RabbitMQ over TLS (AMQPS) — section 5.5 / 13
PHISHGUARD_AMQP_URL=amqps://user:pass@rabbitmq.internal:5671/
PHISHGUARD_COMMANDS_EXCHANGE=phishguard.commands
PHISHGUARD_EVENTS_EXCHANGE=phishguard.events
# Campaign-scoped command queue (section 12 queue isolation)
PHISHGUARD_COMMAND_QUEUE=phishguard.commands.<campaign-uuid>
PHISHGUARD_PREFETCH_COUNT=10

# Evidence upload target (section 2 / 7.3)
PHISHGUARD_EVIDENCE_API_BASE=https://control-plane.internal/api

# Timing
PHISHGUARD_HEARTBEAT_INTERVAL_SECONDS=30

# Logging
PHISHGUARD_LOG_LEVEL=INFO
PHISHGUARD_LOG_JSON=true
