{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phishguard/contracts/events/evidence.download.json",
  "title": "evidence.download payload",
  "description": "Python -> Laravel. Authorized lab download metadata only — never real secrets (STRATEGY.md section 5.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "mime_type", "file_size", "sha256"],
  "properties": {
    "session_id": { "type": "string", "format": "uuid" },
    "original_filename": { "type": "string" },
    "mime_type": { "type": "string" },
    "file_size": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
  }
}
