{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phishguard/contracts/events/security.phishing_detected.json",
  "title": "security.phishing_detected payload",
  "description": "Python -> Laravel. Explainable risk assessment, not proof of maliciousness (STRATEGY.md section 10).",
  "type": "object",
  "additionalProperties": false,
  "required": ["url", "risk_score", "classification"],
  "properties": {
    "url": { "type": "string" },
    "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "classification": { "type": "string" },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "severity", "description"],
        "properties": {
          "type": { "type": "string" },
          "severity": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] },
          "description": { "type": "string" }
        }
      }
    }
  }
}
